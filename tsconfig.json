{
	"compilerOptions": {
		"baseUrl": ".",
		"module": "ESNext",
		"target": "ES2018",
		"noImplicitAny": true,
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"importHelpers": true,
		"isolatedModules": true,
		"strict": true,
		"strictNullChecks": true,
		"lib": ["DOM", "ES2018"]
	},
	"include": ["src/**/*.ts", "test/**/*.mts"]
}
