{
	"name": "obsidian-todo-sidebar",
	"version": "1.0.0",
	"description": "Obsidian plugin that shows the checkboxes of the active note in a sidebar.",
	"main": "main.js",
	"private": true,
	"packageManager": "pnpm@11.22.0",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"test": "node --test --experimental-strip-types test/parser.test.mts"
	},
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.10.0",
		"builtin-modules": "^4.0.0",
		"esbuild": "^0.28.2",
		"obsidian": "^1.13.1",
		"tslib": "^2.8.1",
		"typescript": "^5.9.0"
	}
}
