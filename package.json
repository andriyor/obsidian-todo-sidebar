{
	"name": "obsidian-todo-sidebar",
	"version": "1.0.2",
	"description": "Obsidian plugin that shows the checkboxes of the active note in a sidebar.",
	"main": "main.js",
	"private": true,
	"packageManager": "pnpm@11.22.0",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"test": "node --test --experimental-strip-types test/parser.test.mts",
		"lint": "eslint .",
		"format": "prettier --write ."
	},
	"license": "MIT",
	"devDependencies": {
		"@e18e/eslint-plugin": "^0.8.0",
		"@types/node": "^22.10.0",
		"@typescript-eslint/parser": "^8.67.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.8.1",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"obsidian": "^1.13.1",
		"prettier": "^3.9.6",
		"tslib": "^2.8.1",
		"typescript": "^5.9.0"
	}
}
